{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.example/fictional-ec/pack-v1.json",
  "title": "FantasyStore Pack Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "name",
    "version",
    "author",
    "description"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{1,62}[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,2})\\.(0|[1-9][0-9]{0,2})$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    }
  }
}

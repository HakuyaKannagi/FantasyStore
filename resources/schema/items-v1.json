{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.example/fictional-ec/items-v1.json",
  "title": "FantasyStore Items v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "items": {
      "type": "array", "minItems": 1, "maxItems": 2000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_id", "name", "price", "category", "description", "attributes", "images"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "price": {
            "type": "object", "additionalProperties": false,
            "required": ["significand", "exponent"],
            "properties": {
              "significand": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(0|[1-9]|[1-9][0-9]{0,62}[1-9])$"},
              "exponent": {"type": "string", "minLength": 1, "maxLength": 19, "pattern": "^(0|[1-9][0-9]{0,18})$"}
            }
          },
          "category": {"type": "string", "minLength": 1, "maxLength": 100},
          "description": {"type": "string", "maxLength": 20000},
          "attributes": {
            "type": "object", "maxProperties": 100,
            "propertyNames": {"minLength": 1, "maxLength": 100},
            "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
          },
          "images": {
            "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^assets/[A-Za-z0-9._/-]+\\.(png|jpg|jpeg|webp)$"}
          }
        }
      }
    }
  }
}
